# Copie para .env na raiz. Nunca versione sua chave real.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Só é necessária quando LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Usado apenas no modo auto, que busca novos artigos.
URL_SEMANTIC_SCHOLAR=https://api.semanticscholar.org/graph/v1/paper/search
# Opcional: busca pública sem chave sujeita aos limites do serviço.
SEMANTIC_SCHOLAR_API_KEY=
